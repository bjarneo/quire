<?xml version="1.0" encoding="utf-8"?>
<!-- The Keystore key does not move to a new device. Leave the encrypted secrets out of backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="quire_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="quire_secure.xml" />
    </device-transfer>
</data-extraction-rules>
